# Caddy obține și reînnoiește automat certificatul HTTPS (Let's Encrypt) pentru APP_DOMAIN.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
}

# Site-uri suplimentare, doar pe server (de exemplu aplicația de test, creată de test-setup.sh în /opt/ttm/sites)
import /etc/caddy/sites/*.caddy
