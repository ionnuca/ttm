# Copiați acest fișier în .env și completați valorile. Fișierul .env nu se urcă în Git.

# Parola bazei de date PostgreSQL
DB_PASSWORD=ttm

# Administratorul creat la prima pornire (dacă parola lipsește, se generează una și se afișează în log)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Permite crearea de conturi noi din pagina publică "Cont nou"
APP_REGISTRATION_ENABLED=true

# "demo" încarcă 10 jucători demonstrativi și utilizatorul jucator / jucator123. Lăsați gol în producție.
SPRING_PROFILES_ACTIVE=
